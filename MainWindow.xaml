<Window x:Class="DiskSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskSweep.ViewModels"
        xmlns:models="clr-namespace:DiskSweep.Models"
        Title="DiskSweep - Storage Capacity &amp; System Cleaner [Administrator]" 
        Icon="Assets/app_icon.png"
        Height="790" Width="1200" MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Drive Capacity Strip -->
            <RowDefinition Height="*"/>    <!-- Main Workspace Tabs -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Menu Bar -->
        <Menu Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDarkBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Refresh Drives" Command="{Binding RefreshDrivesCommand}" InputGestureText="Ctrl+R"/>
                <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+,"/>
                <Separator Background="{DynamicResource BorderDarkBrush}"/>
                <MenuItem Header="Open _Disk Management" Click="MenuOpenDiskMgmt_Click"/>
                <MenuItem Header="Windows _Storage Sense" Click="MenuOpenStorageSense_Click"/>
                <Separator Background="{DynamicResource BorderDarkBrush}"/>
                <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Scan">
                <MenuItem Header="_Scan All Cleanable Targets" Command="{Binding ScanCleanableCommand}" InputGestureText="F5"/>
                <MenuItem Header="Scan Drive for _Large Files" Command="{Binding ScanLargeFilesCommand}"/>
                <MenuItem Header="_Cancel Operation" Command="{Binding CancelOperationCommand}" InputGestureText="Esc"/>
            </MenuItem>
            <MenuItem Header="_Selection">
                <MenuItem Header="Select _Recommended Safe" Command="{Binding SelectRecommendedCommand}"/>
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <MenuItem Header="_Deselect All" Command="{Binding DeselectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_Themes">
                <MenuItem Header="Charcoal Dark (Default)" Click="MenuTheme_Click" Tag="Charcoal"/>
                <MenuItem Header="OLED Pure Black" Click="MenuTheme_Click" Tag="OLED"/>
                <MenuItem Header="Midnight Navy" Click="MenuTheme_Click" Tag="MidnightNavy"/>
                <MenuItem Header="Matrix Green" Click="MenuTheme_Click" Tag="MatrixGreen"/>
                <Separator Background="{DynamicResource BorderDarkBrush}"/>
                <MenuItem Header="Classic Light (White Theme)" Click="MenuTheme_Click" Tag="ClassicLight"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Open _User Temp Folder" Click="MenuOpenUserTemp_Click"/>
                <MenuItem Header="Open _Windows Temp Folder" Click="MenuOpenWindowsTemp_Click"/>
                <MenuItem Header="Launch Windows _Disk Cleanup (cleanmgr)" Click="MenuLaunchCleanmgr_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About DiskSweep" Click="MenuAbout_Click" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- 2. Classic Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Brand Wordmark Logo -->
                    <Border Background="Transparent" Margin="4,0,18,0" VerticalAlignment="Center">
                        <Image Source="Assets/brand_logo.png" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="DiskSweep Storage Utility" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Scan Button -->
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ScanCleanableCommand}" ToolTip="Scan all temporary, cache, and cleanable targets (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan System" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Clean Button -->
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanSelectedCommand}" ToolTip="Safely purge selected items without harming system">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clean Selected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{x:Null}" Width="1" Background="{DynamicResource BorderDarkBrush}" Margin="8,2"/>

                    <!-- Selection Buttons -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectRecommendedCommand}" ToolTip="Select safe and auto-rebuilding caches only">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Safe Defaults"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectAllCommand}" ToolTip="Select all items across all categories">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☑️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Select All"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeselectAllCommand}" ToolTip="Clear all selections">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬜" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Deselect All"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{x:Null}" Width="1" Background="{DynamicResource BorderDarkBrush}" Margin="8,2"/>

                    <!-- Refresh Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshDrivesCommand}" ToolTip="Reload drive space statistics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh Drives"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenSettingsCommand}" ToolTip="Configure appearance, themes, and safe deletion options">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CancelOperationCommand}" 
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            ToolTip="Halt active scan or deletion">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Rock-Steady Selection Summary Badge in Toolbar -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Target: " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSelectedFormatted}" FontWeight="Bold" Foreground="#3FB950" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" (" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSelectedFiles, StringFormat={}{0:N0}}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" files)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 3. Feature 1: Drive Capacity & Percentage Overview Strip (Non-Colliding Responsive Grid) -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Row: Responsive Grid eliminating collisions -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Section Title with Icon & Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="VOLUMES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="STORAGE CAPACITY &amp; DRIVE HEALTH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Distinct Storage Metrics Badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Pool: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalDriveCapacity}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C2E24" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="3" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Available: " FontSize="11" Foreground="#99DDB0"/>
                                <TextBlock Text="{Binding TotalDriveFree}" FontSize="11" FontWeight="Bold" Foreground="#3FB950"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Drives List Cards -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DriveItem}">
                            <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,6" Width="268" Padding="10,8">
                                <Border.ContextMenu>
                                    <ContextMenu Background="{DynamicResource HeaderDarkBrush}">
                                        <MenuItem Header="Open Drive in File Explorer" Command="{Binding DataContext.OpenDriveInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Drive Letter & Label -->
                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource HeaderDarkBrush}" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileSystem}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Row 1: Space Usage Bar -->
                                    <Grid Grid.Row="1" Margin="0,7,0,5">
                                        <ProgressBar Style="{StaticResource SpaceProgressBarStyle}" 
                                                     Value="{Binding UsedPercentage, Mode=OneWay}" 
                                                     Foreground="{Binding FreePercentage, Converter={StaticResource FreePercentToBrushConverter}}"/>
                                    </Grid>

                                    <!-- Row 2: Free space and percentage -->
                                    <DockPanel Grid.Row="2">
                                        <TextBlock Text="{Binding FreeDisplay, StringFormat={}{0} free}" FontSize="11" Foreground="#3FB950" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding FreePercentage, StringFormat={}{0:F1}% free}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 4. Main Work Area (Tabs) -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" Background="{DynamicResource BgDarkBrush}" BorderThickness="0" Margin="8,8,8,0">
            <!-- Tab 1: System Cleaner -->
            <TabItem Header="🧹 System Cleaner">
                <Grid Background="{DynamicResource SurfaceDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Categories & Items Tree/List -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CleanCategory}">
                                    <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Category Header -->
                                            <Border Grid.Row="0" Background="{DynamicResource HeaderDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                                                <DockPanel>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                                                    <!-- Category Total Info Badges -->
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ItemCountFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <Border Background="#1C2E24" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="3" Padding="8,2">
                                                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="Bold" FontSize="12" Foreground="#3FB950"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>

                                            <!-- Items Grid Inside Category -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:CleanItem}">
                                                        <Border Background="Transparent" BorderBrush="{DynamicResource HeaderDarkBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                                                            <Border.ContextMenu>
                                                                <ContextMenu Background="{DynamicResource HeaderDarkBrush}">
                                                                    <MenuItem Header="Open Folder in File Explorer" 
                                                                              Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                              CommandParameter="{Binding}"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" 
                                                                              Command="{Binding DataContext.SelectCleanItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>   <!-- Checkbox -->
                                                                    <ColumnDefinition Width="240"/>    <!-- Name -->
                                                                    <ColumnDefinition Width="80"/>     <!-- Safety Badge -->
                                                                    <ColumnDefinition Width="110"/>    <!-- Size -->
                                                                    <ColumnDefinition Width="100"/>    <!-- Files Count -->
                                                                    <ColumnDefinition Width="*"/>      <!-- Target Path -->
                                                                    <ColumnDefinition Width="140"/>    <!-- Status -->
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Checkbox -->
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <!-- Name -->
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Safety Badge -->
                                                                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" Padding="5,1" Background="{DynamicResource BgDarkBrush}" BorderThickness="1" BorderBrush="{Binding Safety, Converter={StaticResource SafetyToBrushConverter}}">
                                                                    <TextBlock Text="{Binding Safety, Converter={StaticResource SafetyToStringConverter}}" FontSize="9" FontWeight="Bold" Foreground="{Binding Safety, Converter={StaticResource SafetyToBrushConverter}}"/>
                                                                </Border>

                                                                <!-- Size -->
                                                                <TextBlock Grid.Column="3" Text="{Binding SizeFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="#3FB950" VerticalAlignment="Center"/>

                                                                <!-- Count -->
                                                                <TextBlock Grid.Column="4" Text="{Binding CountFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                                <!-- Path -->
                                                                <TextBlock Grid.Column="5" Text="{Binding TargetPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding TargetPath}"/>

                                                                <!-- Status -->
                                                                <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Description Panel -->
                    <Border Grid.Row="1" Background="{DynamicResource HeaderDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ℹ️ Safety &amp; Target Details:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedCleanItem.Name, TargetNullValue='Overview'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedCleanItem.Description, TargetNullValue='Select any category or cache item above to review its target folder. All files are safely removed; if any file is in use by a running process, DiskSweep automatically skips it without crashing or interrupting your work.'}" 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedCleanItem.TargetPath, StringFormat='Target Path: {0}'}" 
                                           Visibility="{Binding SelectedCleanItem, Converter={StaticResource NullToVisibilityConverter}}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Remade Space Analyzer with Game Protection & Top Folders -->
            <TabItem Header="📊 Space Analyzer">
                <Grid Background="{DynamicResource SurfaceDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Warning Banner -->
                        <RowDefinition Height="Auto"/> <!-- Controls Strip -->
                        <RowDefinition Height="*"/>    <!-- DataGrids -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: High-Visibility Anti-Corruption Warning Banner -->
                    <Border Grid.Row="0" Background="#2B1D0E" BorderBrush="#D29922" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="8,8,8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CAUTION: GAME &amp; APPLICATION FILE CORRUPTION WARNING" FontWeight="Bold" FontSize="11" Foreground="#F0883E"/>
                                <TextBlock Text="Large files residing in Program Files, Epic Games, Steam, Riot Games, or Windows are required by their games. Deleting individual engine chunks (.ucas/.pak/.rpf) will corrupt your games! Only delete standalone personal files you recognize (e.g., video recordings, ISOs, installer .exe). To reclaim space from games, uninstall them cleanly through their launcher." 
                                           FontSize="11" Foreground="#E6EDF3" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Analyzer Controls Strip -->
                    <Border Grid.Row="1" Background="{DynamicResource HeaderDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Target Scope: " VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                <ComboBox Width="250" ItemsSource="{Binding DriveTargetOptions}" SelectedItem="{Binding SelectedDriveTarget}" Margin="0,0,12,0"/>

                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ScanLargeFilesCommand}" ToolTip="Scan selected drive or all drives for space hogs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔎 Analyze Storage" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Separator Style="{x:Null}" Width="1" Background="{DynamicResource BorderDarkBrush}" Margin="12,2"/>

                                <!-- View Mode Selector -->
                                <RadioButton Content="📄 Individual Files" IsChecked="{Binding ShowLargeFilesView}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton Content="📁 Major Folders" IsChecked="{Binding ShowLargeFoldersView}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding LargeFiles.Count, StringFormat={}{0} items cataloged}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DockPanel>
                    </Border>

                    <!-- Row 2: View 0 (Large Files DataGrid) -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding LargeFiles}" SelectedItem="{Binding SelectedLargeFile}" 
                              Visibility="{Binding ShowLargeFilesView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{DynamicResource HeaderDarkBrush}">
                                <MenuItem Header="Open Folder in File Explorer" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedLargeFile}"/>
                                <MenuItem Header="Move File to Recycle Bin" Command="{Binding DeleteLargeFileCommand}" CommandParameter="{Binding SelectedLargeFile}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!-- Risk Badge Column -->
                            <DataGridTemplateColumn Header="Safety Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:LargeFileItem}">
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Background="#1E1E1E" BorderThickness="1" BorderBrush="{Binding RiskBadgeColor}">
                                            <TextBlock Text="{Binding RiskBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding RiskBadgeColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Type / Source Context" Binding="{Binding ParentContext}" Width="200"/>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="240"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="100"/>
                            <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="75"/>
                            <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModifiedFormatted}" Width="140"/>
                            <DataGridTextColumn Header="Folder Directory" Binding="{Binding DirectoryPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 2: View 1 (Large Folders DataGrid) -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding LargeFolders}" SelectedItem="{Binding SelectedLargeFolder}" 
                              Visibility="{Binding ShowLargeFoldersView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{DynamicResource HeaderDarkBrush}">
                                <MenuItem Header="Open Folder in File Explorer" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedLargeFolder}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!-- Risk Badge Column -->
                            <DataGridTemplateColumn Header="Category" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:LargeFolderItem}">
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Background="#1E1E1E" BorderThickness="1" BorderBrush="{Binding RiskBadgeColor}">
                                            <TextBlock Text="{Binding RiskBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding RiskBadgeColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Folder Name" Binding="{Binding FolderName}" Width="220"/>
                            <DataGridTextColumn Header="Total Size" Binding="{Binding TotalSizeFormatted}" Width="120"/>
                            <DataGridTextColumn Header="File Count" Binding="{Binding FileCount, StringFormat={}{0:N0} large files}" Width="120"/>
                            <DataGridTextColumn Header="Context" Binding="{Binding Category}" Width="220"/>
                            <DataGridTextColumn Header="Full Folder Path" Binding="{Binding FolderPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Activity Log -->
            <TabItem Header="📋 Activity Log">
                <Grid Background="{DynamicResource SurfaceDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource HeaderDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <TextBlock Text="Live Execution &amp; Audit Log" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource ToolbarButtonStyle}" Click="BtnClearLog_Click"/>
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="{DynamicResource BgDarkBrush}" Foreground="#3FB950" 
                             FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="8"/>
                </Grid>
            </TabItem>

            <!-- Tab 4: Settings & Themes (With White Theme Added) -->
            <TabItem Header="⚙️ Settings &amp; Themes">
                <ScrollViewer Background="{DynamicResource SurfaceDarkBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20" MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="Settings &amp; Personalization" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Customize interface themes, deletion behavior, safety cushions, and analysis thresholds." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                        <!-- Section 1: Themes (5 Themes: Charcoal, OLED, Midnight Navy, Matrix Green, Classic Light) -->
                        <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🎨 Visual Theme" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Select a theme below to instantly update the entire application." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Theme 1: Charcoal -->
                                    <RadioButton Grid.Column="0" GroupName="ThemeGroup" Content="Charcoal Dark" Tag="Charcoal" Click="ThemeRadio_Click"
                                                 IsChecked="True" Margin="0,0,6,0">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Background="#181818" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="4" Padding="8,8" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="Charcoal Dark" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="VS Dark Classic" FontSize="9" Foreground="#888888" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>

                                    <!-- Theme 2: OLED -->
                                    <RadioButton Grid.Column="1" GroupName="ThemeGroup" Content="OLED Black" Tag="OLED" Click="ThemeRadio_Click" Margin="0,0,6,0">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Background="#000000" BorderBrush="#00FF9D" BorderThickness="2" CornerRadius="4" Padding="8,8" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="OLED Black" FontWeight="Bold" FontSize="11" Foreground="#00FF9D"/>
                                                        <TextBlock Text="Pure Black/Neon" FontSize="9" Foreground="#888888" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>

                                    <!-- Theme 3: Midnight Navy -->
                                    <RadioButton Grid.Column="2" GroupName="ThemeGroup" Content="Midnight Navy" Tag="MidnightNavy" Click="ThemeRadio_Click" Margin="0,0,6,0">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Background="#0B0F17" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="4" Padding="8,8" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="Midnight Navy" FontWeight="Bold" FontSize="11" Foreground="#60A5FA"/>
                                                        <TextBlock Text="Cyber Nord Dark" FontSize="9" Foreground="#888888" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>

                                    <!-- Theme 4: Matrix Green -->
                                    <RadioButton Grid.Column="3" GroupName="ThemeGroup" Content="Matrix Green" Tag="MatrixGreen" Click="ThemeRadio_Click" Margin="0,0,6,0">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Background="#060A06" BorderBrush="#10B981" BorderThickness="2" CornerRadius="4" Padding="8,8" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="Matrix Green" FontWeight="Bold" FontSize="11" Foreground="#34D399"/>
                                                        <TextBlock Text="Terminal Emerald" FontSize="9" Foreground="#888888" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>

                                    <!-- Theme 5: Classic Light (White Theme) -->
                                    <RadioButton Grid.Column="4" GroupName="ThemeGroup" Content="Classic Light" Tag="ClassicLight" Click="ThemeRadio_Click">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Background="#FFFFFF" BorderBrush="#0066CC" BorderThickness="2" CornerRadius="4" Padding="8,8" Cursor="Hand">
                                                    <StackPanel>
                                                        <TextBlock Text="Classic Light" FontWeight="Bold" FontSize="11" Foreground="#1C2024"/>
                                                        <TextBlock Text="Crisp White" FontSize="9" Foreground="#6C757D" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Deletion & Safety Preferences -->
                        <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🛡️ Deletion &amp; Safety Controls" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Configure cushions against accidental data removal." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                <CheckBox Content="24-Hour Safety Cushion: Preserve temporary files created or modified in the last 24 hours" 
                                          IsChecked="{Binding SafeMode24Hours, Mode=TwoWay}" Margin="0,4,0,8"/>

                                <CheckBox Content="Recycle Bin Safe Mode: Send deleted items to Windows Recycle Bin instead of permanent deletion" 
                                          IsChecked="{Binding MoveToRecycleBinInsteadOfPermanent, Mode=TwoWay}" Margin="0,4,0,8"/>

                                <CheckBox Content="Prompt Confirmation: Require confirmation before executing a cleanup pass" 
                                          IsChecked="{Binding ShowConfirmDialog, Mode=TwoWay}" Margin="0,4,0,8"/>

                                <CheckBox Content="Startup Scan: Automatically analyze cleanable targets when DiskSweep launches" 
                                          IsChecked="{Binding AutoScanOnStartup, Mode=TwoWay}" Margin="0,4,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Space Analyzer Filter Threshold -->
                        <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📊 Space Analyzer Filter" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Set minimum file size threshold for discovering space-consuming files." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Large File Minimum Size: " VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                    <ComboBox Width="160" SelectedValue="{Binding LargeFileSizeThresholdMB, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="25 MB" Tag="25"/>
                                        <ComboBoxItem Content="50 MB (Default)" Tag="50"/>
                                        <ComboBoxItem Content="100 MB" Tag="100"/>
                                        <ComboBoxItem Content="250 MB" Tag="250"/>
                                        <ComboBoxItem Content="500 MB" Tag="500"/>
                                        <ComboBoxItem Content="1 GB" Tag="1000"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveSettingsCommand}" Width="160" HorizontalAlignment="Left" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 Save Settings" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 5. Status Bar (Rock-Steady Multi-Column Layout: Zero Text Jitter) -->
        <StatusBar Grid.Row="4" Background="{DynamicResource HeaderDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderDarkBrush}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Progress Bar -->
                            <ColumnDefinition Width="Auto"/> <!-- Action Status Text -->
                            <ColumnDefinition Width="Auto"/> <!-- Freed Metric Badge (Fixed min-width) -->
                            <ColumnDefinition Width="Auto"/> <!-- Deleted Files Badge (Fixed min-width) -->
                            <ColumnDefinition Width="*"/>    <!-- File Name with Ellipsis -->
                            <ColumnDefinition Width="Auto"/> <!-- Total Drives -->
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Col 0: Progress bar -->
            <StatusBarItem Grid.Column="0">
                <ProgressBar Width="110" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}"
                             Value="{Binding ProgressValue}"/>
            </StatusBarItem>

            <!-- Col 1: Steady Action Status -->
            <StatusBarItem Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="{Binding LiveActionText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StatusBarItem>

            <!-- Col 2: Rock-steady Freed Space Badge -->
            <StatusBarItem Grid.Column="2" Margin="0,0,8,0">
                <Border Background="#1C2E24" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="3" Padding="8,2" MinWidth="110">
                    <TextBlock Text="{Binding LiveFreedText}" FontWeight="Bold" FontSize="11" Foreground="#3FB950" TextAlignment="Center"/>
                </Border>
            </StatusBarItem>

            <!-- Col 3: Rock-steady Deleted Count Badge -->
            <StatusBarItem Grid.Column="3" Margin="0,0,10,0">
                <Border Background="{DynamicResource PanelDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2" MinWidth="95">
                    <TextBlock Text="{Binding LiveCountText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"/>
                </Border>
            </StatusBarItem>

            <!-- Col 4: Monospace filename preview in dedicated trailing box (never moves the badges!) -->
            <StatusBarItem Grid.Column="4">
                <TextBlock Text="{Binding LiveFileName}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>

            <!-- Col 5: Right Drives Count -->
            <StatusBarItem Grid.Column="5" Margin="10,0,0,0">
                <TextBlock Text="{Binding TotalDrivesCount, StringFormat={}{0} Drives Monitored}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
