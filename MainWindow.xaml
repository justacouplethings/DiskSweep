<Window x:Class="DiskSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskSweep.ViewModels"
        xmlns:models="clr-namespace:DiskSweep.Models"
        Title="DiskSweep - Storage Capacity &amp; System Cleaner [Administrator]" 
        Icon="Assets/app_icon.png"
        Height="760" Width="1160" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Drive Capacity Strip -->
            <RowDefinition Height="*"/>    <!-- Main Workspace Tabs -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Menu Bar -->
        <Menu Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDarkBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Refresh Drives" Command="{Binding RefreshDrivesCommand}" InputGestureText="Ctrl+R"/>
                <Separator Background="{StaticResource BorderDarkBrush}"/>
                <MenuItem Header="Open _Disk Management" Click="MenuOpenDiskMgmt_Click"/>
                <MenuItem Header="Windows _Storage Sense" Click="MenuOpenStorageSense_Click"/>
                <Separator Background="{StaticResource BorderDarkBrush}"/>
                <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Scan">
                <MenuItem Header="_Scan All Cleanable Targets" Command="{Binding ScanCleanableCommand}" InputGestureText="F5"/>
                <MenuItem Header="Scan Drive for _Large Files" Command="{Binding ScanLargeFilesCommand}"/>
                <MenuItem Header="_Cancel Operation" Command="{Binding CancelOperationCommand}" InputGestureText="Esc"/>
            </MenuItem>
            <MenuItem Header="_Selection">
                <MenuItem Header="Select _Recommended Safe" Command="{Binding SelectRecommendedCommand}"/>
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <MenuItem Header="_Deselect All" Command="{Binding DeselectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Open _User Temp Folder" Click="MenuOpenUserTemp_Click"/>
                <MenuItem Header="Open _Windows Temp Folder" Click="MenuOpenWindowsTemp_Click"/>
                <MenuItem Header="Launch Windows _Disk Cleanup (cleanmgr)" Click="MenuLaunchCleanmgr_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About DiskSweep" Click="MenuAbout_Click" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- 2. Classic Toolbar (Revo / Process Hacker inspired) -->
        <Border Grid.Row="1" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Brand Wordmark Logo -->
                    <Border Background="Transparent" Margin="4,0,18,0" VerticalAlignment="Center">
                        <Image Source="Assets/brand_logo.png" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="DiskSweep Storage Utility" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Scan Button -->
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ScanCleanableCommand}" ToolTip="Scan all temporary, cache, and cleanable targets (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan System" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Clean Button -->
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanSelectedCommand}" ToolTip="Safely purge selected items without harming system">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clean Selected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{x:Null}" Width="1" Background="{StaticResource BorderDarkBrush}" Margin="8,2"/>

                    <!-- Selection Buttons -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectRecommendedCommand}" ToolTip="Select safe and auto-rebuilding caches only">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Safe Defaults"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SelectAllCommand}" ToolTip="Select all items across all categories">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☑️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Select All"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeselectAllCommand}" ToolTip="Clear all selections">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬜" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Deselect All"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{x:Null}" Width="1" Background="{StaticResource BorderDarkBrush}" Margin="8,2"/>

                    <!-- Refresh Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshDrivesCommand}" ToolTip="Reload drive space statistics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh Drives"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CancelOperationCommand}" 
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            ToolTip="Halt active scan or deletion">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹️" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Selection Summary Pill in Toolbar -->
                <Border DockPanel.Dock="Right" Background="#1E1E1E" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ready to Clean: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSelectedFormatted}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSelectedFiles, StringFormat={}{0:N0}}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" files)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 3. Feature 1: Drive Capacity & Percentage Overview Strip (WinDirStat / RAMMap style) -->
        <Border Grid.Row="2" Background="#1C1C1C" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="STORAGE CAPACITY &amp; DRIVE HEALTH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="Total Storage: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDriveCapacity}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Free: " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDriveFree}" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Drives List -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DriveItem}">
                            <Border Background="#252526" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,6" Width="265" Padding="8,6">
                                <Border.ContextMenu>
                                    <ContextMenu Background="#252526">
                                        <MenuItem Header="Open Drive in File Explorer" Command="{Binding DataContext.OpenDriveInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Drive Letter & Label -->
                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="#333333" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileSystem}" FontSize="10" Foreground="#AAAAAA"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Row 1: Space Usage Bar -->
                                    <Grid Grid.Row="1" Margin="0,6,0,4">
                                        <ProgressBar Style="{StaticResource SpaceProgressBarStyle}" 
                                                     Value="{Binding UsedPercentage, Mode=OneWay}" 
                                                     Foreground="{Binding FreePercentage, Converter={StaticResource FreePercentToBrushConverter}}"/>
                                    </Grid>

                                    <!-- Row 2: Free space and percentage -->
                                    <DockPanel Grid.Row="2">
                                        <TextBlock Text="{Binding FreeDisplay, StringFormat={}{0} free}" FontSize="11" Foreground="#4EC9B0" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding FreePercentage, StringFormat={}{0:F1}% free}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 4. Main Work Area (Tabs) -->
        <TabControl Grid.Row="3" Background="{StaticResource BgDarkBrush}" BorderThickness="0" Margin="8,8,8,0">
            <!-- Tab 1: System Cleaner (Features 2 & 3) -->
            <TabItem Header="🧹 System Cleaner">
                <Grid Background="{StaticResource SurfaceDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/> <!-- Description Box (Revo style) -->
                    </Grid.RowDefinitions>

                    <!-- Categories & Items Tree/List -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CleanCategory}">
                                    <Border Background="#242424" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Category Header -->
                                                <RowDefinition Height="Auto"/> <!-- Items List -->
                                            </Grid.RowDefinitions>

                                            <!-- Category Header -->
                                            <Border Grid.Row="0" Background="#2C2C2C" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                                                <DockPanel>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                                                    <!-- Category Total Info Badges -->
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Border Background="#1E1E1E" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ItemCountFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <Border Background="#1F3A52" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="8,2">
                                                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="Bold" FontSize="12" Foreground="#4EC9B0"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>

                                            <!-- Items Grid Inside Category -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:CleanItem}">
                                                        <Border Background="Transparent" BorderBrush="#2F2F2F" BorderThickness="0,0,0,1" Padding="12,6">
                                                            <Border.ContextMenu>
                                                                <ContextMenu Background="#252526">
                                                                    <MenuItem Header="Open Folder in File Explorer" 
                                                                              Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                              CommandParameter="{Binding}"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" 
                                                                              Command="{Binding DataContext.SelectCleanItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>   <!-- Checkbox -->
                                                                    <ColumnDefinition Width="240"/>    <!-- Name -->
                                                                    <ColumnDefinition Width="80"/>     <!-- Safety Level Badge -->
                                                                    <ColumnDefinition Width="110"/>    <!-- Size -->
                                                                    <ColumnDefinition Width="100"/>    <!-- Files Count -->
                                                                    <ColumnDefinition Width="*"/>      <!-- Target Path -->
                                                                    <ColumnDefinition Width="130"/>    <!-- Status -->
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Checkbox -->
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                                <!-- Name -->
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Safety Badge -->
                                                                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" Padding="5,1" Background="#1E1E1E" BorderThickness="1" BorderBrush="{Binding Safety, Converter={StaticResource SafetyToBrushConverter}}">
                                                                    <TextBlock Text="{Binding Safety, Converter={StaticResource SafetyToStringConverter}}" FontSize="9" FontWeight="Bold" Foreground="{Binding Safety, Converter={StaticResource SafetyToBrushConverter}}"/>
                                                                </Border>

                                                                <!-- Size -->
                                                                <TextBlock Grid.Column="3" Text="{Binding SizeFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="#4EC9B0" VerticalAlignment="Center"/>

                                                                <!-- Count -->
                                                                <TextBlock Grid.Column="4" Text="{Binding CountFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                                <!-- Path -->
                                                                <TextBlock Grid.Column="5" Text="{Binding TargetPath}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding TargetPath}"/>

                                                                <!-- Status -->
                                                                <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" TextAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Description Panel (Revo Uninstaller style) -->
                    <Border Grid.Row="1" Background="#1D1D1D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ℹ️ Safety &amp; Target Details:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedCleanItem.Name, TargetNullValue='Overview'}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedCleanItem.Description, TargetNullValue='Click on any item above to review its target folder and purpose. DiskSweep deletes safely: active or locked files in use are safely bypassed without crashing or halting the sweep.'}" 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedCleanItem.TargetPath, StringFormat='Target Path: {0}'}" 
                                           Visibility="{Binding SelectedCleanItem, Converter={StaticResource NullToVisibilityConverter}}"
                                           FontSize="10" Foreground="#777777" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Large Files Analyzer (WinDirStat style) -->
            <TabItem Header="📊 Space Analyzer (Large Files)">
                <Grid Background="{StaticResource SurfaceDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Analyzer Controls -->
                        <RowDefinition Height="*"/>    <!-- DataGrid of Large Files -->
                    </Grid.RowDefinitions>

                    <!-- Controls Strip -->
                    <Border Grid.Row="0" Background="#252526" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Target Drive: " VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                <ComboBox Width="140" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="DisplayTitle" Background="#1E1E1E" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ScanLargeFilesCommand}" ToolTip="Scan drive for top 100 space-consuming files (>50MB)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔎 Scan Top Large Files" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding LargeFiles.Count, StringFormat={}{0} large files discovered}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>
                    </Border>

                    <!-- Large Files DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LargeFiles}" SelectedItem="{Binding SelectedLargeFile}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#252526">
                                <MenuItem Header="Open Folder in File Explorer" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedLargeFile}"/>
                                <MenuItem Header="Move File to Recycle Bin" Command="{Binding DeleteLargeFileCommand}" CommandParameter="{Binding SelectedLargeFile}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="250"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="110"/>
                            <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="80"/>
                            <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModifiedFormatted}" Width="150"/>
                            <DataGridTextColumn Header="Folder Directory" Binding="{Binding DirectoryPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Activity Log -->
            <TabItem Header="📋 Activity Log">
                <Grid Background="{StaticResource SurfaceDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252526" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <TextBlock Text="Live Execution &amp; Audit Log" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource ToolbarButtonStyle}" Click="BtnClearLog_Click"/>
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="#181818" Foreground="#4EC9B0" 
                             FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 5. Status Bar -->
        <StatusBar Grid.Row="4" Background="#007ACC" Foreground="#FFFFFF" Padding="8,4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Left Status message & Progress -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="120" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                 Value="{Binding ProgressValue}"/>
                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Center Selected Summary -->
            <StatusBarItem Grid.Column="1" Margin="10,0">
                <TextBlock Text="{Binding TotalSelectedSummary}" FontWeight="SemiBold"/>
            </StatusBarItem>

            <!-- Right Drives Count -->
            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding TotalDrivesCount, StringFormat={}{0} Drives Monitored}" Foreground="#E0E0E0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
